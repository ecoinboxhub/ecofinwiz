# Finwize — Environment Configuration
# Copy this file to .env and fill in your values

# App
APP_NAME=Finwize
APP_VERSION=0.1.0
APP_DEBUG=true
APP_ENV=development

# Security
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://finwize:finwize@localhost:5432/finwize

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=finwize

# Redis
REDIS_URL=redis://localhost:6379/0

# Pinecone (RAG Knowledge Base)
# Required for AI RAG features. Format: pcsk_<project_id>_<rest>
# Get at: https://app.pinecone.io/organization/api-keys
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=finwize-knowledge

# OpenAI (optional, legacy)
OPENAI_API_KEY=your-openai-api-key

# OpenRouter (primary LLM provider) - REQUIRED in production
# At least one of OPENROUTER_API_KEY or GROQ_API_KEY must be set
# Format: sk-or-v1-... 
# Get at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq (alternative LLM provider, faster) - REQUIRED in production
# At least one of OPENROUTER_API_KEY or GROQ_API_KEY must be set
# Format: gsk_...
# Get at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Sentry
SENTRY_DSN=

# CORS
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing.
# Include all frontend domains (web, mobile web, admin panel).
# Format: http(s)://host[:port], e.g., https://app.finwize.com,http://localhost:5300
# Invalid origins will be logged as warnings and ignored at startup.
CORS_ORIGINS=http://localhost:5300,http://localhost:3000,https://finwize.app,https://www.finwize.app,https://staging.finwize.app,https://admin.finwize.app

# Rate Limiting
# RATE_LIMIT_ENABLED: Explicitly enable/disable rate limiting. Auto-enabled in staging/production.
# RATE_LIMIT_REQUESTS: Max requests per window for anonymous users (default: 100)
# RATE_LIMIT_WINDOW_SECONDS: Time window in seconds (default: 60)
# RATE_LIMIT_AUTH_REQUESTS: Max requests per window for authenticated users (default: 200)
# RATE_LIMIT_AUTH_WINDOW_SECONDS: Time window for authenticated users (default: 60)
# RATE_LIMIT_EXEMPT_PATHS: Comma-separated paths exempt from rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=200
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/api/v1/health,/docs,/redoc,/openapi.json,/api/v1/auth/login,/api/v1/auth/register

# Frontend
FRONTEND_URL=http://localhost:5300

# Email (SendGrid + Mailgun)
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM_ADDRESS=noreply@finwize.app
EMAIL_FROM_NAME=Finwize

# SMS (AfricasTalking + Twilio)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=finwize
SMS_FROM_NUMBER=FINWIZE
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments (Paystack + Flutterwave)
# Paystack: REQUIRED in production
# Secret key format: sk_test_... (test) or sk_live_... (production)
# Public key format: pk_test_... (test) or pk_live_... (production)
# Get at: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave: Optional
# Secret key format: FLWSECK_TEST-... or FLWSECK_... (production)
# Public key format: FLWPUBK_TEST-... or FLWPUBK_... (production)
# Get at: https://dashboard.flutterwave.com/settings/api
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Analytics (PostHog)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Storage (AWS S3)
S3_BUCKET_NAME=
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_USE_PATH_STYLE=false
LOCAL_STORAGE_DIR=

# News (NewsAPI)
NEWSAPI_KEY=

# Exchange Rates
EXCHANGE_RATE_API_KEY=

# Embeddings (Jina AI)
JINA_EMBEDDING_API_KEY=
