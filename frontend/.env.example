# EcoFinwize — Frontend environment template (placeholders only).
# Copy to `.env` or set inside your Vercel project (Settings > Environment Variables).

# PUBLIC — inline into the browser bundle by Vite. Any string starting with
# VITE_ becomes public and MUST NOT contain secrets.
VITE_API_URL=https://ecofinwiz-api.onrender.com/api/v1

# PUBLIC — Google OAuth web client id. This is safe to expose (it is sent to
# Google from the browser). "disabled" turns Google login off.
VITE_GOOGLE_CLIENT_ID=212233580664-j4diufuimp6qimk69sevf1km53oq1k1p.apps.googleusercontent.com

# PUBLIC — Sentry DSN (client-side tracing only). Leave empty if unused.
VITE_SENTRY_DSN=

# PUBLIC — app metadata used for error envelopes.
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# ==========================================================================
# SERVER-SIDE ONLY (never VITE_-prefixed in the browser, never committed):
#   Backend secrets live in `backend/.env` / Render env vars:
#   SECRET_KEY, GOOGLE_CLIENT_SECRET, DATABASE_URL, OPENROUTER_API_KEY,
#   GROQ_API_KEY, PINECONE_API_KEY, PAYSTACK_SECRET_KEY, SENDGRID_API_KEY ... 
# See root `.env.example` for the full server list.
# ==========================================================================