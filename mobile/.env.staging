# Staging environment configuration
# This file is loaded by flutter_dotenv in staging builds
# Do not commit secrets to this file - use --dart-define or GitHub secrets for CI

# App metadata
APP_NAME=EcoFinwize Staging
APP_VERSION=1.0.0+1

# API Configuration (can be overridden by --dart-define=API_BASE_URL)
# API_BASE_URL=https://staging-api.finwize.app/api/v1

# Feature flags
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true