# Development environment configuration
# This file is loaded by flutter_dotenv in development builds
# Do not commit secrets to this file - use --dart-define or GitHub secrets for CI

# App metadata
APP_NAME=EcoFinwize Dev
APP_VERSION=1.0.0+1

# API Configuration (can be overridden by --dart-define=API_BASE_URL)
# API_BASE_URL=http://10.0.2.2:8100/api/v1

# Feature flags
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false