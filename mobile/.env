# EcoFinwize Mobile App Configuration
# Copy the appropriate flavor file (.env.development, .env.staging, .env.production)
# to this file, or use flutter_dotenv with --dart-define for CI/CD.
# 
# For local development:
#   cp .env.development .env
# 
# For CI/CD, use --dart-define=API_BASE_URL=... instead of this file.

# App metadata
APP_NAME=EcoFinwize
APP_VERSION=1.0.0+1

# API Configuration (can be overridden by --dart-define=API_BASE_URL)
# API_BASE_URL=http://10.0.2.2:8100/api/v1

# Feature flags
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false